---
import Pibo from './Pibo.astro';
import type { Locale } from '../lib/site';
import { copy } from '../lib/site';
const { lang = 'en' } = Astro.props as { lang?: Locale };
const t = copy[lang];
---
<div class="worlds" data-worlds aria-label={t.orbitLabel} role="img">
  <div class="worlds-glow"></div>
  <svg class="orbit-lines" viewBox="0 0 640 620" aria-hidden="true">
    <ellipse cx="323" cy="310" rx="264" ry="195" transform="rotate(-28 323 310)" />
    <ellipse cx="323" cy="310" rx="194" ry="265" transform="rotate(-32 323 310)" />
    <path d="M75 445C140 570 474 545 569 295" />
    <path class="orbit-cross" d="M85 196h14m-7-7v14m433 251h14m-7-7v14M436 58h10m-5-5v10" />
  </svg>
  <canvas class="worlds-canvas" aria-hidden="true"></canvas>
  <div class="world-stage" aria-hidden="true">
    <div class="world-island island-main">
      <svg viewBox="0 0 340 290" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="island-side" x2=".2" y2="1"><stop stop-color="#a899d8" /><stop offset="1" stop-color="#8675b5" /></linearGradient>
          <linearGradient id="house-front" x2="1" y2="1"><stop stop-color="#fbf5db"/><stop offset="1" stop-color="#ebdfc0"/></linearGradient>
        </defs>
        <ellipse cx="173" cy="252" rx="120" ry="21" fill="#40334f" opacity=".07"/>
        <path d="M24 155q146-81 292 0v45q-146 80-292 0Z" fill="url(#island-side)"/>
        <ellipse cx="170" cy="155" rx="146" ry="64" fill="#c4b6eb"/>
        <ellipse cx="170" cy="150" rx="130" ry="51" fill="#d1c4f2"/>
        <path d="M176 181c-4-20-6-27 8-39" stroke="#eee4fe" stroke-width="20" fill="none"/>
        <path d="M127 106v51l45 24 47-26v-51l-46-25Z" fill="url(#house-front)"/>
        <path d="m172 130 47-26v51l-47 26Z" fill="#ddd1b4"/>
        <path d="m116 108 57-64 58 61-59 32Z" fill="#ed9b7e"/>
        <path d="m173 44 58 61-59 32Z" fill="#cf7b65"/>
        <path d="M149 144v-17q0-11 10-5v28Z" fill="#9d8bbf"/>
        <path d="m189 129 13-7v15l-13 7Z" fill="#9d8bbf"/>
        <path d="M199 64V45l13 6v27Z" fill="#efd9b9"/>
        <path d="m195 44 15-7 13 7-14 8Z" fill="#faf0d9"/>
        <ellipse cx="84" cy="150" rx="23" ry="10" fill="#b1a2d6"/>
        <path d="M83 145v-43" stroke="#79785b" stroke-width="5" stroke-linecap="round"/>
        <path d="M83 128c-44-11-36-50-8-55 10-2 18 5 19 13 24-8 36 24 13 36Z" fill="#9aae83"/>
        <path d="M82 103c-26-6-22-28-7-30 10-2 18 5 19 13 12-4 23 1 23 12Z" fill="#b6c99e"/>
        <ellipse cx="253" cy="164" rx="17" ry="8" fill="#b4a5d9"/>
        <path d="M250 161v-23m0 9c-13-1-17-12-13-19 12-1 18 8 13 19m2-7c-1-13 11-17 18-12-1 11-8 16-18 12" fill="#92a77d"/>
        <g fill="#f7e8b6"><circle cx="108" cy="177" r="3"/><circle cx="230" cy="189" r="3"/><circle cx="62" cy="143" r="2"/></g>
        <path d="m67 184 7 3m190-47 7 3" stroke="#f3e8ff" stroke-width="4" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="world-island island-garden">
      <svg viewBox="0 0 180 170" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="92" cy="151" rx="57" ry="10" fill="#40334f" opacity=".06"/>
        <path d="M20 104v21q68 39 140 0v-21Z" fill="#91a27b"/>
        <ellipse cx="90" cy="104" rx="70" ry="31" fill="#c4d1a8"/>
        <ellipse cx="90" cy="103" rx="59" ry="24" fill="#d8e3be"/>
        <path d="M83 101V63m1 13C49 73 46 44 63 31c24 4 34 24 21 45m0-13C78 30 106 18 125 29c-1 28-16 40-41 34" fill="#7e9e6c" stroke="#7e9e6c" stroke-width="4" stroke-linecap="round"/>
        <path d="M84 63c6-21 22-31 41-34" stroke="#a9c38b" stroke-width="3" fill="none"/>
        <ellipse cx="119" cy="117" rx="11" ry="6" fill="#b7c598"/>
        <path d="M42 101h7m78-11h6" stroke="#eff1d1" stroke-width="4" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="world-island island-water">
      <svg viewBox="0 0 150 155" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 92v24q57 32 115 0V92Z" fill="#8ba7b3"/>
        <ellipse cx="76" cy="92" rx="58" ry="27" fill="#c9e0e6"/>
        <ellipse cx="75" cy="92" rx="39" ry="16" fill="#a8cbd7"/>
        <path d="m74 89 6-45 14 30Z" fill="#fff5db"/>
        <path d="m80 44-5 45-20-12Z" fill="#ecd7b6"/>
        <path d="m52 88 42 3-10 9-21-1Z" fill="#c7836c"/>
        <path d="M35 100h9m47 9h12" stroke="#eaf7f3" stroke-width="3" stroke-linecap="round"/>
      </svg>
    </div>
    <Pibo class="hero-pibo" />
    <span class="little-star star-one">✳</span>
    <span class="little-star star-two">✦</span>
    <span class="little-dot dot-one"></span>
    <span class="little-dot dot-two"></span>
    <span class="little-dot dot-three"></span>
    <div class="world-note"><span class="note-dot"></span>{lang === 'en' ? 'a world of possibilities' : '가능성이 자라는 작은 세계'}</div>
  </div>
  <span class="world-hint"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m6 3 9 8-5 1-2 5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>{t.hint}</span>
</div>
