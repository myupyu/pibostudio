---
import ProductCard from './ProductCard.astro';import PostCard from './PostCard.astro';
import {getProducts,getArticles,urlFor,metadata,type Route} from '../lib/content';
const {route}=Astro.props as {route:Route};const {lang,product}=route;const ko=lang==='ko';
const products=await getProducts();const meta=metadata(route);
const posts=route.view==='products'?[]:await getArticles(route.view==='guides'?'guides':'blog',lang,product?.data.slug);
const title=route.view==='products'?(route.kind==='game'?(ko?'게임':'Games'):route.kind==='app'?(ko?'앱':'Apps'):(ko?'게임 & 앱':'Games & apps')):route.view==='guides'?(ko?'플레이 가이드':'Play guides'):(ko?'저널':'Journal');
---
<main id="main" class="collection-page wrap"><span id="top"></span><nav class="breadcrumbs" aria-label={ko?'현재 위치':'Breadcrumbs'}><a href={product?urlFor(lang,product.data.slug):urlFor(lang)}>{product?.data.copy[lang].name??'Pibo Studio'}</a><span aria-hidden="true">/</span><span>{title}</span></nav><header class="collection-heading"><p class="section-label">{product?.data.copy[lang].name??'PIBO STUDIO'}</p><h1 class="page-title">{title}{ko?'.':''}</h1><p>{meta.description}</p></header>
{route.view==='products'?<><nav class="category-tabs" aria-label={ko?'작품 종류':'Product categories'}>{[{path:'projects',label:ko?'모두':'All',kind:undefined},{path:'games',label:ko?'게임':'Games',kind:'game'},{path:'apps',label:ko?'앱':'Apps',kind:'app'}].map(c=><a href={urlFor(lang,c.path)} aria-current={route.kind===c.kind?'page':undefined}>{c.label}</a>)}</nav>{products.filter(p=>!route.kind||p.data.kind===route.kind).length?<div class="product-grid">{products.filter(p=>!route.kind||p.data.kind===route.kind).map(product=><ProductCard product={product} lang={lang}/>)}</div>:<div class="collection-empty"><h2>{ko?'앱의 이야기도 곧 이곳에.':'Our apps will find a home here, too.'}</h2><p>{ko?'지금은 두 게임의 작은 세계를 먼저 둘러보세요.':'For now, take a little look inside our two games.'}</p><a class="button button-dark" href={urlFor(lang,'games')}>{ko?'게임 둘러보기':'Explore the games'} →</a></div>}</>:<>{!product&&<nav class="category-tabs" aria-label={ko?'제품별 블로그':'Product journals'}><a href={urlFor(lang,'blog')} aria-current="page">{ko?'모두':'All'}</a>{products.map(p=><a href={urlFor(lang,p.data.slug+'/blog')}>{p.data.copy[lang].name}</a>)}</nav>}<div class="post-grid">{posts.map(post=><PostCard post={post} product={products.find(p=>p.id===(post.data.product??post.data.game))}/>)}</div>{product&&<div class="collection-bottom"><a class="text-link" href={urlFor(lang,product.data.slug)}>{ko?'게임 소개로 돌아가기':'Back to the game'} →</a><a class="text-link" href={urlFor(lang,product.data.slug+(route.view==='guides'?'/blog':'/guides'))}>{route.view==='guides'?(ko?'블로그':'Journal'):(ko?'플레이 가이드':'Play guides')} →</a></div>}</>}
</main>
