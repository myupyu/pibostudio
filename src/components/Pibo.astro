---
interface Props { class?: string; label?: string; variant?: 'sunny' | 'lilac'; }
const { class: className = '', label, variant = 'sunny' } = Astro.props;
const body = variant === 'sunny' ? '#f6b58c' : '#c8b9f5';
---
<svg class:list={['pibo', className]} viewBox="0 0 220 220" role={label ? 'img' : undefined} aria-label={label} aria-hidden={!label ? 'true' : undefined} xmlns="http://www.w3.org/2000/svg">
  <ellipse cx="111" cy="199" rx="65" ry="9" fill="#302b27" opacity=".08" />
  <g class="pibo-body">
    <path d="M72 163c-5 10-5 24 6 27 10 2 19-7 20-15m36-5c4 13 11 23 20 19 10-4 6-18-1-27" fill={body} />
    <path d="M47 119c-19-7-30 2-25 13 3 6 13 8 27 5m121-28c20-5 29 4 23 14-4 7-13 9-24 7" fill={body} />
    <path d="M45 127c-4-24 0-50 14-66 6-8 19-10 25-22 5-12 17-15 26-8 7 6 14 8 26 8 20-1 26 14 29 27 16 18 21 42 14 66-7 29-26 45-66 46-38 0-62-17-68-51Z" fill={body} />
    <path d="M95 34c-3-16 3-24 18-24-2 15-8 22-18 24Z" fill="#91a479" />
    <path d="M102 30c6-12 15-14 25-8-7 9-15 12-25 8Z" fill="#b6c696" />
    <path d="M83 99v10m45-15v10" stroke="#38322d" stroke-width="8" stroke-linecap="round" />
    <path d="M98 121q10 11 20-3" fill="none" stroke="#38322d" stroke-width="4" stroke-linecap="round" />
    <ellipse cx="68" cy="119" rx="10" ry="5" fill="#e48270" opacity=".45" />
    <ellipse cx="145" cy="113" rx="10" ry="5" fill="#e48270" opacity=".45" />
    <path d="M61 77c5-10 12-15 18-17" stroke="white" stroke-opacity=".25" stroke-width="7" stroke-linecap="round" fill="none" />
  </g>
</svg>
