---
import ProductArt from './ProductArt.astro';
import PostCard from './PostCard.astro';
import {getArticles,urlFor,type Product} from '../lib/content';
import {contactEmail,type Locale} from '../lib/site';
const {product,lang}=Astro.props as {product:Product,lang:Locale};const t=product.data.copy[lang];const ko=lang==='ko';const app=product.data.kind==='app';
const posts=await getArticles('blog',lang,product.data.slug);const guides=await getArticles('guides',lang,product.data.slug);const policies=await getArticles('policies',lang,product.data.slug);
---
<main id="main" class="product-page wrap"><span id="top"></span>
  <nav class="breadcrumbs" aria-label={ko?'현재 위치':'Breadcrumbs'}><a href={urlFor(lang,'projects')}>{ko?'게임 & 앱':'Games & apps'}</a><span aria-hidden="true">/</span><span>{t.name}</span></nav>
  <section class="product-hero" aria-labelledby="product-name"><div class="product-intro"><p class="eyebrow"><span class="status-dot"></span>{t.status}</p><h1 class="page-title" id="product-name">{t.name}</h1><p class="product-tagline">{t.tagline}</p><p class="product-description">{t.description}</p><div class="product-actions">{product.data.stores.length?product.data.stores.map(s=><a class="button button-dark" href={s.url} target="_blank" rel="noopener">{s.label} <span aria-hidden="true">↗</span></a>):<a class="button button-dark" href={urlFor(lang,product.data.slug+'/blog')}>{ko?'가게 이야기 읽기':'Stories from the shop'} <span aria-hidden="true">→</span></a>}{product.data.officialSite&&<a class="button" href={product.data.officialSite[lang]} target="_blank" rel="noopener">{ko?'공식 사이트':'Official website'} ↗</a>}</div><p class="purchase-note">{t.purchase}</p></div><ProductArt product={product} lang={lang} interactive/></section>
  <dl class="product-facts">{t.facts.map(f=><div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
  <section class="product-story section"><div class="section-head"><div><p class="section-label">{app?(ko?'일상에 더하는 작은 편리함':'MADE FOR EVERYDAY LIFE'):(ko?'작은 세계에 들어가면':'STEP INTO A LITTLE WORLD')}</p><h2>{app?(ko?'이렇게 함께해요.':'A little help, every day.'):(ko?'나의 손길로 달라지는 이야기.':'A world shaped by your little choices.')}</h2></div><p class="section-intro">{t.genre}</p></div><p class="product-lead">{t.intro}</p><div class="feature-grid">{t.features.map((f,i)=><article><span class="feature-number">0{i+1}</span><h3>{f.title}</h3><p>{f.body}</p></article>)}</div></section>
  {t.gallery.length>0&&<section class="product-gallery section" aria-labelledby="screens-title"><div class="section-head"><div><p class="section-label">{ko?'게임 속에서':'FROM THE GAME'}</p><h2 id="screens-title">{ko?'한 장면씩, 조금 더 가까이.':'A few moments, a little closer.'}</h2></div><p class="section-intro">{ko?'실제 게임 화면입니다. 그림을 누르면 크게 볼 수 있어요.':'Actual game screens. Open an image for a closer look.'}</p></div><div class="screen-grid">{t.gallery.map((shot,i)=><figure><a href={shot.src} target="_blank" rel="noopener" aria-label={`${shot.caption} ${ko?'크게 보기':'View full image'}`}><img src={shot.src} alt={shot.caption} width="393" height="852" loading="lazy"/></a><figcaption><span>0{i+1}</span>{shot.caption}</figcaption></figure>)}</div></section>}
  {posts.length>0&&<section class="product-journal section"><div class="section-head"><div><p class="section-label">{ko?'만드는 이야기, 함께 읽는 이야기':'STORIES TO KEEP YOU COMPANY'}</p><h2>{ko?(product.data.accent==='night'?'가게에서 온 편지.':'농장에서 온 편지.'):'Notes from a little world.'}</h2></div><a class="text-link" href={urlFor(lang,product.data.slug+'/blog')}>{ko?'블로그 전체 보기':'All stories'} <span aria-hidden="true">→</span></a></div><div class="post-grid">{posts.slice(0,3).map(post=><PostCard post={post} product={product}/>)}</div></section>}
  <section class="product-help section"><div><p class="section-label">{ko?'시작하기 전에':'GOOD TO KNOW'}</p><h2>{ko?'궁금한 작은 것들.':'A few little questions.'}</h2></div><div class="product-faq">{t.faq.map(f=><details><summary>{f.q}<span aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}<div class="product-resources">{guides.length>0&&<a href={urlFor(lang,product.data.slug+'/guides')}>{ko?'플레이 가이드':'Play guides'} →</a>}{policies.some(p=>p.data.slug==='support')&&<a href={urlFor(lang,product.data.slug+'/support')}>{ko?'게임 지원':'Game support'} →</a>}{product.data.privacy?<a href={product.data.privacy[lang]} target="_blank" rel="noopener">{ko?'개인정보 처리방침':'Privacy policy'} ↗</a>:policies.some(p=>p.data.slug==='privacy')&&<a href={urlFor(lang,product.data.slug+'/privacy')}>{ko?'개인정보 처리방침':'Privacy policy'} →</a>}{product.data.officialSite&&<a href={product.data.officialSite[lang]} target="_blank" rel="noopener">{ko?'공식 사이트':'Official website'} ↗</a>}</div></div></section>
  <aside class="product-contact"><img src={product.data.icon} alt="" width="56" height="56"/><div><h2>{ko?'작은 인사를 기다립니다.':'A little hello is always welcome.'}</h2><p>{app?(ko?'앱에 관한 질문이나 발견한 문제를 전해 주세요.':'Questions about the app, or something you noticed? Let us know.'):(ko?'게임에 관한 질문이나 발견한 문제를 전해 주세요.':'Questions about the game, or something you noticed? Let us know.')}</p></div><a class="button button-dark" href={`mailto:${contactEmail}?subject=${encodeURIComponent(t.name)}`}>{ko?'문의하기':'Get in touch'} <span aria-hidden="true">↗</span></a></aside>
</main>
