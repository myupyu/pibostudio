---
import {render} from 'astro:content';import PostArt from './PostArt.astro';import PostCard from './PostCard.astro';
import {articleUrl,getArticles,urlFor,dateLabel,type Route} from '../lib/content';
const {route}=Astro.props as {route:Route};const post=route.entry!;const {lang,product}=route;const ko=lang==='ko';const {Content}=await render(post);const policy=post.collection==='policies';
const parent=policy?(product?urlFor(lang,product.data.slug):urlFor(lang)):urlFor(lang,`${product?product.data.slug+'/':''}${post.collection}`);
const label=policy?(product?.data.copy[lang].name??'Pibo Studio'):post.collection==='guides'?(ko?'플레이 가이드':'Play guides'):(ko?'블로그':'Journal');
const related=policy?[]:(await getArticles(post.collection as 'blog'|'guides',lang,product?.data.slug)).filter(p=>p.id!==post.id).slice(0,2);
---
<main id="main" class:list={['article-page','wrap',policy?'policy-page':'']}><span id="top"></span><nav class="breadcrumbs" aria-label={ko?'현재 위치':'Breadcrumbs'}><a href={parent}>{label}</a><span aria-hidden="true">/</span><span>{post.data.title}</span></nav><article><header class="article-heading"><p class="section-label">{product?.data.copy[lang].name??'PIBO STUDIO'}</p><h1 class="page-title">{post.data.title}</h1><p class="article-description">{post.data.description}</p>{!policy&&<p class="post-meta"><time datetime={post.data.date}>{dateLabel(post.data.date,lang)}</time>{post.data.updated&&post.data.updated!==post.data.date&&<> · {ko?'업데이트':'Updated'} <time datetime={post.data.updated}>{dateLabel(post.data.updated,lang)}</time></>}</p>}</header>{!policy&&<PostArt post={post} product={product}/>}<div class="article-body"><Content/></div>{post.data.source&&<p class="source-note">{ko?'StockPets 독립 사이트의 글을 PIBO Studio 형식에 맞춰 옮기고 현재 앱 안내를 반영했습니다.':'Adapted from the StockPets standalone site with current app information.'} <a href={post.data.source} target="_blank" rel="noopener">{ko?'원문':'Original article'} ↗</a></p>}</article>{related.length>0&&<aside class="related-posts"><h2>{ko?'함께 읽어 보세요.':'A little more to read.'}</h2><div class="post-grid">{related.map(post=><PostCard post={post} product={product}/>)}</div></aside>}<div class="collection-bottom"><a class="text-link" href={parent}>← {ko?'목록으로':'Back to the list'}</a>{product&&<a class="text-link" href={urlFor(lang,product.data.slug)}>{ko?'게임 소개':'Meet the game'} →</a>}</div></main>
