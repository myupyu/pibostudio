---
import Layout from '../layouts/Layout.astro';
import Worlds from './Worlds.astro';
import Pibo from './Pibo.astro';
import ProductCard from './ProductCard.astro';
import PostCard from './PostCard.astro';
import {getProducts,getArticles,urlFor} from '../lib/content';
import { copy, contactEmail, type Locale } from '../lib/site';
const { lang = 'en' } = Astro.props as { lang?: Locale };
const t = copy[lang];
const products=await getProducts();
const posts=(await getArticles('blog',lang)).slice(0,3);
---
<Layout lang={lang}>
  <main id="main">
    <section class="hero wrap" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span>{t.eyebrow}</p>
        <h1 id="hero-title">{t.headline[0]}<br/><span class="hero-line">{t.headline[1]}<svg class="headline-spark" viewBox="0 0 52 52" aria-hidden="true"><path d="m26 4 4 15 12-9-8 13 15 3-15 4 9 12-13-8-4 15-3-15-13 8 9-12-15-4 15-3-9-13 13 9Z" fill="currentColor"/></svg></span></h1>
        <p class="hero-description">{t.intro}</p>
        <div class="hero-actions"><a class="button button-dark" href="#products">{t.explore}<span aria-hidden="true">↗</span></a><a class="text-link" href="#studio">{t.meet}<span aria-hidden="true">→</span></a></div>
        <div class="hero-footnote"><span class="tiny-spark">✳</span><span>{t.orbitLabel}</span></div>
      </div>
      <Worlds lang={lang} />
    </section>
    <div class="values-strip wrap" aria-label={lang === 'en' ? 'Our spirit' : '우리가 담는 마음'}>{t.ticker.map((value, i) => <><span>{value}</span>{i < 2 && <span class="strip-flower" aria-hidden="true">✳</span>}</>)}<a href="#products" class="scroll-cue" aria-label={lang === 'en' ? 'Scroll to our games and apps' : '게임과 앱으로 이동'}>↓</a></div>

    <div id="games" aria-hidden="true"></div>
    <section class="products-section wrap section" id="products" aria-labelledby="products-title">
      <div class="section-head reveal"><div><p class="section-label">{t.productsLabel}</p><h2 id="products-title">{t.productsTitle}</h2></div><p class="section-intro">{t.productsIntro}</p></div>
      <div class="product-grid reveal">{products.map(product=><ProductCard product={product} lang={lang}/>)}</div>
      <a class="text-link section-more" href={urlFor(lang,'projects')}>{lang==='ko'?'게임 & 앱 전체 보기':'All games & apps'} <span aria-hidden="true">→</span></a>
    </section>

    <section class="story-section" id="studio" aria-labelledby="story-title"><div class="story-inner wrap"><div class="story-copy reveal"><p class="section-label">{t.storyLabel}</p><h2 id="story-title">{t.storyTitle[0]}<br/><span>{t.storyTitle[1]}</span></h2><p class="story-lead">{t.storyBody}</p><p class="story-detail">{t.storySub}</p></div><div class="story-art reveal" aria-hidden="true"><div class="story-frame"><span class="frame-corner">+</span><span class="frame-number">A LITTLE BIT OF PIBO</span><Pibo variant="lilac" class="story-pibo"/><span class="story-stamp">{t.storyStamp[0]}<br/>{t.storyStamp[1]}</span><svg class="story-star" viewBox="0 0 60 60"><path d="m30 0 6 19L53 7l-12 18 19 5-19 6 12 17-17-12-6 19-5-19L7 53l12-17L0 30l19-5L7 7l18 12Z" fill="currentColor"/></svg></div><span class="story-scribble">little by little, lovely things grow.</span></div></div></section>

    <section class="journal-section wrap section" id="journal" aria-labelledby="journal-title"><div class="section-head reveal"><div><p class="section-label">{t.journalLabel}</p><h2 id="journal-title">{t.journalTitle}</h2></div><p class="section-intro">{t.journalIntro}</p></div><div class="post-grid reveal">{posts.map(post=><PostCard post={post} product={products.find(p=>p.id===(post.data.product??post.data.game))}/>)}</div><a class="text-link section-more" href={urlFor(lang,'blog')}>{lang==='ko'?'저널 전체 보기':'All journal stories'} <span aria-hidden="true">→</span></a></section>

    <section class="contact-section wrap reveal" id="contact" aria-labelledby="contact-title"><div><p class="section-label">{t.ctaLabel}</p><h2 id="contact-title">{t.ctaTitle}</h2><p>{t.ctaBody}</p></div><a class="contact-circle" href={`mailto:${contactEmail}`} aria-label={contactEmail}><span aria-hidden="true">↗</span></a><div class="contact-spark" aria-hidden="true">✳</div></section>
  </main>
</Layout>
